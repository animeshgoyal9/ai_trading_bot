# Alpaca API Credentials (Paper Trading)
# Get free paper trading account at: https://alpaca.markets/
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Trading Configuration
TRADING_CAPITAL=10000
MAX_POSITION_SIZE=0.1
STOP_LOSS_PERCENT=0.02
TAKE_PROFIT_PERCENT=0.05

# Sentiment Analysis API Keys (Optional - bot works with free sources)
# NewsAPI: Get free key at https://newsapi.org (100 requests/day)
NEWS_API_KEY=your_newsapi_key_here

# Alpha Vantage: Get free key at https://www.alphavantage.co (500 requests/day)
ALPHA_VANTAGE_KEY=your_alphavantage_key_here

# Sentiment Configuration
USE_SENTIMENT=true
SENTIMENT_LOOKBACK_DAYS=7
SENTIMENT_WEIGHT=0.3
