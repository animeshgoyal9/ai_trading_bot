# Alpaca API Credentials (Paper Trading)
# Get free paper trading account at: https://alpaca.markets/
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Trading Configuration
TRADING_CAPITAL=10000
MAX_POSITION_SIZE=0.2
STOP_LOSS_PERCENT=0.07
TAKE_PROFIT_PERCENT=0.15

# Trading Mode: 'stocks' or 'crypto'
TRADING_MODE=stocks

# Extended Hours Trading (pre-market 4AM-9:30AM ET, after-hours 4PM-8PM ET)
ENABLE_EXTENDED_HOURS=true

# Mistral AI Agent (PRIMARY — free tier available)
# Get API key at: https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_MODEL=mistral-small-latest

# Email Notifications
# Use Gmail + an App Password (NOT your regular password)
# Generate App Password at: https://myaccount.google.com/apppasswords
NOTIFY_EMAIL=you@gmail.com
NOTIFY_APP_PASSWORD=xxxx xxxx xxxx xxxx

# NewsAPI (free — 100 requests/day)
# Get key at: https://newsapi.org
NEWS_API_KEY=your_newsapi_key

# Alpha Vantage (free — 500 requests/day)
# Get key at: https://www.alphavantage.co
ALPHA_VANTAGE_KEY=your_alphavantage_key

# Optional: Gemini AI Agent (free tier available)
# Get API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
USE_GEMINI_AGENT=false
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MIN_CONFIDENCE=0.3

# Optional: Claude AI Agent (paid)
# Get API key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key
USE_CLAUDE_AGENT=false
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MIN_CONFIDENCE=0.3

# Sentiment Analysis (optional, disabled by default)
USE_SENTIMENT=false
SENTIMENT_LOOKBACK_DAYS=7
SENTIMENT_WEIGHT=0.3
